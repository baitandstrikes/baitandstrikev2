<section class="section-wrap"><h1>{{ 'general.cart' | t }}</h1>{% if cart.empty? %}<p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy' }}{% endif %}<div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2><p>{{ item.variant.title | escape }}</p>{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<p>{{ item.final_line_price | money }}</p>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}<label for="CartQuantity-{{ forloop.index }}">{{ 'product.quantity' | t }}</label><input id="CartQuantity-{{ forloop.index }}" name="updates[]" type="number" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment }}"><a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div></div>{% endfor %}</div><div class="cart-summary"><label for="CartNote">{{ 'cart.note' | t }}</label><textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<h2>{{ 'cart.total' | t }} {{ cart.total_price | money }}</h2><p>{{ 'cart.shipping' | t }}</p><button class="button button-light" type="submit" name="update">{{ 'cart.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></div></form>{% endif %}</section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
