<article class="section-wrap page-copy"><p class="eyebrow">{{ article.published_at | date: '%d %B %Y' }}</p><h1>{{ article.title | escape }}</h1>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager' }}{% endif %}<div class="rte">{{ article.content }}</div></article>
{% schema %}{"name":"Article","settings":[]}{% endschema %}
