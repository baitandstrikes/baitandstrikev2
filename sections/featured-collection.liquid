<section class="section-wrap"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }} ↗</a></div><div class="product-grid">{% for item in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', item: item %}{% else %}{% for i in (1..4) %}<article class="product-card"><div class="product-picture"><img src="{{ 'watch-editorial.svg' | asset_url }}" width="1600" height="1100" alt="" loading="lazy"></div><div class="product-meta"><p class="eyebrow">{{ 'general.preview' | t }}</p><h3>{{ 'product.placeholder' | t }}</h3><p>{{ 'general.choose_collection' | t }}</p></div></article>{% endfor %}{% endfor %}</div></section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SELECTED FOR YOU"},{"type":"text","id":"heading","label":"Heading","default":"Modern classics"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Product count","min":4,"max":12,"step":4,"default":4}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
