<section class="section-wrap"><p class="eyebrow">{{ 'general.collection' | t }}</p><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div>{% paginate collection.products by 24 %}<form class="collection-controls" method="get"><div class="filters">{% for filter in collection.filters %}{% if filter.type == 'list' or filter.type == 'boolean' %}<details><summary>{{ filter.label | escape }}</summary>{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}</details>{% elsif filter.type == 'price_range' %}<details><summary>{{ filter.label | escape }}</summary><label>{{ 'general.min_price' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}></label><label>{{ 'general.max_price' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}></label></details>{% endif %}{% endfor %}</div><label for="SortBy">{{ 'general.sort' | t }}</label>{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}<select id="SortBy" name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button class="button" type="submit">{{ 'general.apply' | t }}</button><a href="{{ collection.url }}">{{ 'general.clear' | t }}</a></form><div class="product-grid">{% for item in collection.products %}{% render 'product-card', item: item %}{% else %}<p>{{ 'general.empty' | t }}</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>
{% schema %}{"name":"Collection","settings":[]}{% endschema %}
