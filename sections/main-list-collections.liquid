<section class="section-wrap"><h1>{{ 'general.collections' | t }}</h1>{% paginate collections by 24 %}<div class="product-grid">{% for collection in collections %}<article><a href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}<h2>{{ collection.title | escape }}</h2></a></article>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>
{% schema %}{"name":"Collections","settings":[]}{% endschema %}
