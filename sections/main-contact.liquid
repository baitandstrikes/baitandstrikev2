<section class="section-wrap page-copy"><h1>{{ page.title | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'contact.success' | t }}</p>{% endif %}<label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}"><label for="ContactEmail">{{ 'general.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email | escape }}"><label for="ContactBody">{{ 'contact.message' | t }}</label><textarea id="ContactBody" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea><button class="button" type="submit">{{ 'contact.send' | t }}</button>{% endform %}</section>
{% schema %}{"name":"Contact","settings":[]}{% endschema %}
