{% assign variant = product.selected_or_first_available_variant %}
<section class="product-page section-wrap"><div class="product-gallery">{% for media in product.media %}{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1400 | image_tag: widths: '500,900,1400', sizes: '(max-width: 700px) 100vw, 55vw', loading: 'lazy' }}{% when 'video' %}{{ media | video_tag: controls: true }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}</div><div class="product-info"><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><p class="product-price">{{ variant.price | money }} {% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %}</p>{% form 'product', product %}{{ form.errors | default_errors }}{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ variant.id }}">{% else %}<label for="Variant-{{ section.id }}">{{ 'product.variant' | t }}</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for option in product.variants %}<option value="{{ option.id }}" {% if option.id == variant.id %}selected{% endif %}>{{ option.title | escape }} — {{ option.price | money }}{% unless option.available %} · {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% endif %}<label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="{{ variant.quantity_rule.min }}" step="{{ variant.quantity_rule.increment }}" value="{{ variant.quantity_rule.min }}" {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %}><button class="button full-width" type="submit" name="add" {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>{% if variant.available %}{{ form | payment_button }}{% endif %}{% endform %}<details open class="accordion"><summary>{{ 'product.description' | t }}</summary><div class="rte">{{ product.description }}</div></details>{% for block in section.blocks %}{% case block.type %}{% when 'detail' %}<details class="accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name":"Product","blocks":[{"type":"@app"},{"type":"detail","name":"Information","settings":[{"type":"text","id":"title","label":"Title","default":"Details"},{"type":"richtext","id":"text","label":"Content","default":"<p>Add product care or delivery information here.</p>"}]}]}
{% endschema %}
