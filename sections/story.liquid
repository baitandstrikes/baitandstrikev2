<section class="story section-wrap"><div class="story-image">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(max-width: 700px) 100vw, 50vw', loading: 'lazy' }}{% else %}<img src="{{ 'watch-editorial.svg' | asset_url }}" width="1600" height="1100" alt="" loading="lazy">{% endif %}</div><div class="story-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="button" href="{{ section.settings.link }}">{{ section.settings.button | escape }}</a>{% endif %}</div></section>
{% schema %}
{"name":"Brand story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR PHILOSOPHY"},{"type":"text","id":"heading","label":"Heading","default":"Beautifully considered. Made for a lifetime."},{"type":"richtext","id":"text","label":"Story","default":"<p>We believe the finest things are the ones you return to every day. Thoughtful details, distinctive character, and a commitment to lasting quality.</p>"},{"type":"text","id":"button","label":"Button","default":"OUR STORY"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Brand story"}]}
{% endschema %}
