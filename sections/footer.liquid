<footer class="footer"><div class="footer-top"><div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p>{% form 'customer', class: 'newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">{{ 'general.email' | t }}</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'general.email' | t }}" autocomplete="email" required><button type="submit" aria-label="{{ 'general.subscribe' | t }}">→</button>{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'general.subscribed' | t }}</p>{% endif %}{% endform %}</div><nav aria-label="{{ 'general.footer' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ powered_by_link }}</span><div class="payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div></footer>
{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good things take time."},{"type":"textarea","id":"text","label":"Newsletter text","default":"Join our world for new collections, stories, and inspiration."},{"type":"link_list","id":"menu","label":"Footer menu","default":"footer"}]}
{% endschema %}
