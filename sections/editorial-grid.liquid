<section class="editorial-grid">{% for block in section.blocks %}<a class="editorial-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1400 | image_tag: widths: '600,900,1400', sizes: '(max-width: 700px) 100vw, 50vw', loading: 'lazy' }}{% else %}<img src="{{ 'watch-editorial.svg' | asset_url }}" width="1600" height="1100" alt="" loading="lazy">{% endif %}<div><p class="eyebrow">{{ block.settings.eyebrow | escape }}</p><h2>{{ block.settings.heading | escape }}</h2><span class="text-link">{{ block.settings.button | escape }} ↗</span></div></a>{% endfor %}</section>
{% schema %}
{"name":"Editorial collections","max_blocks":4,"blocks":[{"type":"collection","name":"Collection tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A NEW PERSPECTIVE"},{"type":"text","id":"heading","label":"Heading","default":"Designed to endure"},{"type":"text","id":"button","label":"Link text","default":"DISCOVER"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Editorial collections","blocks":[{"type":"collection","settings":{"heading":"Everyday essentials"}},{"type":"collection","settings":{"heading":"Exceptional by nature"}}]}]}
{% endschema %}
