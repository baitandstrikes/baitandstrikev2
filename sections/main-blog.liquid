<section class="section-wrap"><h1>{{ blog.title | escape }}</h1>{% paginate blog.articles by 12 %}<div class="product-grid">{% for article in blog.articles %}<article>{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}<h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p></article>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>
{% schema %}{"name":"Journal","settings":[]}{% endschema %}
