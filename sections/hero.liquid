<section class="hero" style="--hero-shade: {{ section.settings.shade | divided_by: 100.0 }}">
  {% if section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750,1200,1800,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'hero-image' }}{% else %}<img class="hero-image" src="{{ 'watch-editorial.svg' | asset_url }}" width="1600" height="1100" alt="" fetchpriority="high">{% endif %}
  <div class="hero-content"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}<em>{{ section.settings.italic | escape }}</em></h1><p>{{ section.settings.description | escape }}</p><a class="button button-outline" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }}</a></div>
</section>
{% schema %}
{"name":"Editorial hero","settings":[{"type":"image_picker","id":"image","label":"Lifestyle photograph"},{"type":"range","id":"shade","label":"Image overlay","min":0,"max":80,"step":5,"default":25,"unit":"%"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ART OF EVERYDAY"},{"type":"text","id":"heading","label":"Heading","default":"Every moment tells"},{"type":"text","id":"italic","label":"Italic heading","default":"a story of its own"},{"type":"textarea","id":"description","label":"Description","default":"Exceptional pieces for the moments that matter. Discover a collection made to stay with you."},{"type":"text","id":"button","label":"Button","default":"EXPLORE THE COLLECTION"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Editorial hero"}]}
{% endschema %}
