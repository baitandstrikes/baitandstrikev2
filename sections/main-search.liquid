<section class="section-wrap"><h1>{{ 'general.search' | t }}</h1><form class="search-form" action="{{ routes.search_url }}" method="get"><label class="visually-hidden" for="SearchInput">{{ 'general.search' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}"><button class="button" type="submit">{{ 'general.search' | t }}</button></form>{% if search.performed %}{% paginate search.results by 24 %}<p>{{ 'general.results' | t: count: search.results_count }}</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', item: item %}{% else %}<article class="search-result"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncate: 180 }}</p></article>{% endif %}{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
